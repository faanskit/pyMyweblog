# MyWebLog API Configuration

# Mode: "mobile" (default) or "main"
MYWEBLOG_API_MODE=mobile

# Mobile API (OAuth 2.1 PKCE)
MYWEBLOG_CLIENT_ID=9
MYWEBLOG_CLIENT_SECRET=mwlm1_your_secret_here
MYWEBLOG_REDIRECT_URI=http://localhost:5173/callback
MYWEBLOG_AIRPLANE_ID=your_airplane_id_here

# Main API (OAuth 2.0 Client Credentials)
# To use Main API, switch MYWEBLOG_API_MODE=main and set your token's Client ID and Token
# MYWEBLOG_API_MODE=main
# MYWEBLOG_CLIENT_ID=4711
# MYWEBLOG_CLIENT_SECRET=mwla1_your_main_api_token_here
